int findDigits(int n) {
    int count = 0;
    
    // Use temp to extract each digit from right to left
    for (int temp = n; temp > 0; temp /= 10) {
        int digit = temp % 10;
        
        // Check that digit is not 0 (to avoid division by zero) and divides n evenly
        if (digit != 0 && n % digit == 0) {
            count++;
        }
    }
    
    return count;
}
