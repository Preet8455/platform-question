#include <stdio.h>

int main() {
    int l, r, k;
    
    // Read the three space-separated integers
    if (scanf("%d %d %d", &l, &r, &k) == 3) {
        // Calculate multiples of k up to r minus multiples up to (l - 1)
        int count = (r / k) - ((l - 1) / k);
        
        // Print the result
        printf("%d\n", count);
    }
    
    return 0;
}
