#include <stdio.h>

int main() {
    int n;
    long long factorial = 1;

    // Read the input integer N
    if (scanf("%d", &n) == 1) {
        // Multiply numbers from 1 to N
        for (int i = 1; i <= n; i++) {
            factorial *= i;
        }
        
        // Print the result
        printf("%lld\n", factorial);
    }

    return 0;
}
